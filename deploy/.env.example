# ---------------------------------------------------------------------------
# Production environment for the Audio Notes backend (Compute Engine VM).
#
# Copy this file to `deploy/.env`, fill in real values, then run
# `deploy/deploy.ps1` (Windows) or `deploy/deploy.sh` (macOS/Linux).
# `deploy/.env` is gitignored - never commit real secrets.
#
# The same file is used for two things:
#   1. Compose variable interpolation (IMAGE, DOMAIN) - read from .env on the VM.
#   2. Container environment (everything else) - passed via env_file.
# ---------------------------------------------------------------------------

# === Compose interpolation (NOT read by the app) ===========================

# Full Artifact Registry image reference. deploy.ps1/deploy.sh fill this in
# automatically, but keep it here so a manual `docker compose up` works too.
# Example: asia-south1-docker.pkg.dev/my-project/audionotes/audionotes:latest
IMAGE=CHANGE_ME

# Public hostname Caddy serves and gets an HTTPS certificate for.
# Use a domain you control (its A record -> the VM's static IP), or, with no
# domain, use <VM_STATIC_IP>.sslip.io for a free trusted certificate.
DOMAIN=CHANGE_ME

# === Postgres (runs as a container on the VM) ==============================
# These create the database container. docker-compose derives DATABASE_URL
# (postgresql+psycopg://...@db:5432/<db>) from them. Keep the password
# URL-safe: alphanumeric, '-' and '_' only.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=audionotes
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=audionotes

# === Redis (runs as a container on the VM) =================================
# REDIS_URL is derived by docker-compose (redis://redis:6379/0); nothing to set.

# === App / URLs ============================================================
# Your Vercel frontend URL (no trailing slash). Used for CORS.
FRONTEND_ORIGIN=https://CHANGE_ME.vercel.app
# Public HTTPS URL of this backend (same host as DOMAIN).
BACKEND_PUBLIC_URL=https://CHANGE_ME
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=200
STALE_JOB_MINUTES=20

# === Gnani speech APIs =====================================================
GNANI_API_KEY=CHANGE_ME
GNANI_BASE_URL=https://api.vachana.ai
GNANI_POLL_INTERVAL_SECONDS=10
GNANI_MAX_POLL_SECONDS=1800
GNANI_CLOUD_INGEST=true
GNANI_USE_WEBHOOK=false
GNANI_WEBHOOK_BASE_URL=
GNANI_WEBHOOK_SECRET=
GNANI_DEFAULT_DIARIZATION=false
GNANI_DEFAULT_NUM_SPEAKERS=2
GNANI_DEFAULT_DENOISE=false
GNANI_DEFAULT_BIAS_SCORE=1.0
GNANI_REST_ITN_MAX_SECONDS=60
GNANI_REST_TIMEOUT_SECONDS=120
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MAX_CHARS=3500

# === Gemini ================================================================
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash-lite

# === Supabase Storage ======================================================
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
SUPABASE_SECRET_KEY=CHANGE_ME
SUPABASE_BUCKET=audio-notes
SUPABASE_BUCKET_PUBLIC=false
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600

# === Auth / email ==========================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
FRONTEND_RESET_PASSWORD_URL=https://CHANGE_ME.vercel.app/reset-password
FRONTEND_VERIFY_EMAIL_URL=https://CHANGE_ME.vercel.app/verify-email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
AUTH_RATE_LIMIT_PER_MINUTE=10
