DATABASE_URL=postgresql+psycopg://audionotes:audionotes@localhost:5433/audionotes

# --- Gnani speech APIs ---
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
# Poll the Batch job no more often than the documented 10s minimum.
GNANI_POLL_INTERVAL_SECONDS=10
GNANI_MAX_POLL_SECONDS=1800
# Ingest audio by reference from object storage (no 10 MB upload ceiling, up to 4h).
GNANI_CLOUD_INGEST=true
# Optional: receive terminal job events from Gnani instead of only polling.
GNANI_USE_WEBHOOK=false
GNANI_WEBHOOK_BASE_URL=
GNANI_WEBHOOK_SECRET=
# Defaults for new recordings (can be overridden per upload).
GNANI_DEFAULT_DIARIZATION=false
GNANI_DEFAULT_NUM_SPEAKERS=2
GNANI_DEFAULT_DENOISE=false
GNANI_DEFAULT_BIAS_SCORE=1.0
# Clips up to this length use the REST endpoint so numbers/dates are normalized.
GNANI_REST_ITN_MAX_SECONDS=60
GNANI_REST_TIMEOUT_SECONDS=120

# --- Gnani Timbre TTS (read-aloud summaries) ---
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MAX_CHARS=3500

# --- Gemini (summary, extraction, and the transcript agent) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Flash-Lite is cheap with a higher free-tier quota; override to a full Flash
# model for better summary quality if you have the quota.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- App / storage ---
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
REDIS_URL=redis://localhost:6379/0

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=audio-notes
# Keep the bucket private and serve short-lived signed URLs.
SUPABASE_BUCKET_PUBLIC=false
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600
# Re-queue notes left mid-flight (e.g. a worker died) after this long.
STALE_JOB_MINUTES=20

# --- Auth / email ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
FRONTEND_VERIFY_EMAIL_URL=http://localhost:3000/verify-email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
AUTH_RATE_LIMIT_PER_MINUTE=10
